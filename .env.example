USERNAME=seu_usuario_ou_email
PASSWORD=sua_senha
SITE=https://seu-site-alvo.com

# ---------------------------------------------------------------------------
# HEADLESS — modo janela (opcional, mas importante)
# ---------------------------------------------------------------------------
# 1 (padrão se você omitir esta variável) = sem janela → terminal, cron, servidor.
# 0 = janela visível → use ao depurar no computador.
# Descomente e ajuste se precisar forçar um dos modos:
# HEADLESS=1

# Servidor sem Google Chrome: não defina esta linha (usa Chromium baixado pelo Playwright).
# Máquina local com Chrome instalado (opcional, mais parecido com o Chrome “de verdade”):
# PLAYWRIGHT_CHANNEL=chrome

# IDs dos elementos no HTML (copie do inspetor do navegador)
ID_USERNAME=ID_USERNAME
ID_PASSWORD=ID_PASSWORD
ID_LOGIN=ID_LOGIN

# IDs dos botões após o login
ID_BOTAO_1=ID_BOTAO_1
ID_BOTAO_2=ID_BOTAO_2
